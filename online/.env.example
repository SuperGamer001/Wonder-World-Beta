# Wonder World online server — every setting it reads.
#
# Copy to .env.development to change something on your own machine (nothing is
# needed there: it runs with no file at all). In production do NOT make a file:
# set these in the host's own settings (docs/OPERATIONS.md, *Secrets*), where
# they are encrypted and never in the repository. `.env*` files are ignored by
# git, this one excepted.
#
# src/config.ts is where each is read, checked and described.

# ── Required in production ────────────────────────────────────────────────────
# The server refuses to start in production without these two.
# Make each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PLAYER_KEY_SECRET=

NODE_ENV=production
# The browser edition's exact origin(s), comma separated. https only, no paths, no *.
ALLOWED_ORIGINS=https://play.example.com
# true when a reverse proxy in front of the server sets X-Real-IP / X-Forwarded-For
# (Colyseus Cloud, nginx, a load balancer). Never true without one.
TRUST_PROXY=true

# ── Steam (the desktop edition) ───────────────────────────────────────────────
# Without these every player is a guest with the free edition.
# The Web API key is the PUBLISHER key from Steamworks: server only, never in a client.
STEAM_APP_ID=
STEAM_WEB_API_KEY=
#STEAM_IDENTITY=wonder-world-online
#STEAM_ALLOW_FAMILY_SHARING=true

# ── Who may connect ───────────────────────────────────────────────────────────
# The desktop app's page is served from 127.0.0.1 on a port the system picks.
#ALLOW_LOOPBACK_ORIGINS=true
# A client that sends no Origin at all (not a browser). Off in production.
#ALLOW_NO_ORIGIN=false
# Development and tests only. The server will not start in production with it on.
#DEV_AUTH=false

# ── Versions ──────────────────────────────────────────────────────────────────
# Oldest game version let in ("0.2.0"); empty for any.
#MIN_GAME_VERSION=
# Rooms from games whose blocks this server does not know (gamepacks). Off in production.
#ALLOW_UNKNOWN_CONTENT=false

# ── Editions (JSON; any field left out keeps its default) ─────────────────────
#EDITION_FULL={"canHost":true,"maxRoomPlayers":8,"maxLocalPlayers":4,"canBuild":true,"blockedBlocks":[]}
#EDITION_FREE={"canHost":false,"maxRoomPlayers":4,"maxLocalPlayers":2,"canBuild":true,"blockedBlocks":[]}

# ── Capacity ──────────────────────────────────────────────────────────────────
#MAX_ROOMS=200
#MAX_CONNECTIONS=1500
#MAX_CONNECTIONS_PER_IP=12
#MAX_ROOMS_PER_ACCOUNT=1

# ── Rates (a minute unless said otherwise) ────────────────────────────────────
#RATE_MATCHMAKE_PER_IP=30
#RATE_CREATE_PER_ACCOUNT_HOUR=12
#RATE_AUTH_PER_IP=20
#RATE_NEW_GUESTS_PER_IP_HOUR=10
#RATE_RESOLVE_PER_IP=20
#RATE_RESOLVE_PER_ACCOUNT=12
#RATE_MESSAGES_PER_SECOND=300
#RATE_VIOLATIONS_PER_MINUTE=600
#RATE_INVALID_PER_MINUTE=8
#RATE_HOST_ASKS_PER_SECOND=60

# ── Sizes ─────────────────────────────────────────────────────────────────────
#MAX_HTTP_BODY_BYTES=16384
#MAX_PAYLOAD_BYTES=98304
#MAX_CHUNK_BYTES=81920
#MAX_PLAYER_STATE_BYTES=49152
#MAX_RELAY_BYTES_PER_MINUTE=50331648
#RECENT_EDITS=8192

# ── Play ──────────────────────────────────────────────────────────────────────
#GUEST_GRACE_SEC=30
#HOST_GRACE_SEC=60
#MAX_SPEED=60
#BLOCK_REACH=12
#FLUID_REACH=96
#HIT_REACH=96
#MAX_HIT_DAMAGE=100
#MAX_MOBS=64
#SESSION_TTL_SEC=3600
#GUEST_CREDENTIAL_TTL_DAYS=180

# ── Operations ────────────────────────────────────────────────────────────────
#PORT=2567
#LOG_LEVEL=info
# Keeps the account and address tags in the logs the same across restarts. Any long random string.
#LOG_SALT=
# GET /metrics answers "Authorization: Bearer <this>". Empty: there is no /metrics. 24+ characters.
#METRICS_TOKEN=
# The Colyseus monitor at /monitor, user "admin". Empty: no monitor in production. 16+ characters.
#MONITOR_PASSWORD=

{
  "private": true,
  "name": "wonder-world-online",
  "version": "0.1.0",
  "description": "Wonder World's online multiplayer server (Colyseus)",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "start:prod": "node build/index.js",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit",
    "test": "mocha -r ./test/env.cjs -r tsx \"test/**/*.test.ts\" --exit --timeout 20000",
    "content": "node tools/sync-content.mjs",
    "audit": "npm audit --omit=dev"
  },
  "author": "Alex Fischer, Interlinked Creations",
  "license": "UNLICENSED",
  "dependencies": {
    "@colyseus/schema": "^5.0.36",
    "@colyseus/tools": "^0.18.9",
    "colyseus": "^0.18.9",
    "express": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
